# ==============================================
# hotel-booking-dispatch — environment variables
# Copy this file to .env and adjust the values.
# ==============================================

# --- Server ---
PORT=3001
NODE_ENV=development

# --- Database (SQLite file, path relative to prisma/ directory) ---
DATABASE_URL="file:./data.db"

# --- Sessions ---
# Secret that signs the session cookie. REQUIRED, at least 16 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
# Send the session cookie only over HTTPS. Keep false for local HTTP
# development; set true in production when the app is served over TLS.
SESSION_COOKIE_SECURE=false
# Session lifetime in hours. Also the rolling idle window each request refreshes.
SESSION_MAX_AGE_HOURS=12

# --- Login rate limiting ---
# Max login attempts per IP per window before requests are throttled (429).
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# --- Password hashing ---
# bcrypt work factor (4-15). 10 is a sound default; leave unset to use it.
# BCRYPT_COST=10

# --- Initial administrator account ---
# Created automatically on first server start if no matching account exists.
# On later restarts an existing admin is never overwritten.
# The admin is forced to change this password at first login.
# There is NO built-in default account: in production the server refuses to
# start unless all three values below are set, so it can never fall back to a
# predictable public password. Choose a strong, private initial password.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-immediately
INITIAL_ADMIN_FULL_NAME=Quản trị viên

# Proof-of-creation screenshot storage.
# Where receptionist proof screenshots are written on the server filesystem.
# Only metadata + a safe relative path are stored in SQLite (never image bytes).
# Relative paths are resolved from the repository root. Keep this directory
# backed up together with the SQLite database. Default (development):
PROOF_UPLOAD_DIR=server/uploads/booking-proofs

# Where receptionist issue-report photos are written (same rules as proofs).
ISSUE_UPLOAD_DIR=server/uploads/issue-photos

# --- Proof OCR (advisory extraction only) ---
# Read operational text (booking code, dates, total, payment…) from a proof
# screenshot to help the Admin. It is ADVISORY ONLY: OCR never approves, rejects
# or compares a proof — the Admin always checks the image themselves.
#
# Keep OCR OFF by default. When off, proof upload still works, the Admin views
# the image manually, and each analysis is recorded as DISABLED.
PROOF_OCR_ENABLED=false
# Tesseract language packs, e.g. "eng+vie". Only used when PROOF_OCR_ENABLED=true.
# Enabling real OCR also requires installing the optional dependency:
#   npm install tesseract.js -w server
PROOF_OCR_LANGUAGE=eng+vie
