# ==============================================
# hotel-booking-dispatch — environment variables
# Copy this file to .env and adjust the values.
# ==============================================

# --- Server ---
PORT=3001
NODE_ENV=development

# --- Database (SQLite file, path relative to prisma/ directory) ---
DATABASE_URL="file:./data.db"

# --- Sessions ---
# Use a long random string (e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
SESSION_SECRET=change-me-to-a-long-random-string

# --- Initial administrator account ---
# Created automatically on first server start if no admin exists.
# The admin is forced to change this password at first login.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-immediately
INITIAL_ADMIN_FULL_NAME=Quản trị viên
