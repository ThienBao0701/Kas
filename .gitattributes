# Normalize line endings: LF in the repository, native in the working tree.
* text=auto eol=lf

# Windows-native scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets — never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text
*.woff binary
*.woff2 binary
*.db binary
*.sqlite binary

# Generated files: collapse diffs in review
package-lock.json linguist-generated=true -diff
