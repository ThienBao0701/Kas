// hotel-booking-dispatch — database schema
//
// Money rule: every monetary field is an Int holding whole VND (đồng).
// VND has no minor unit in practice, so integer arithmetic is exact and
// floating point is never used for money anywhere in this system.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  RECEPTIONIST
}

enum BookingStatus {
  DRAFT
  READY
  NEW
  COMPLETED
  ARCHIVED
}

enum PaymentStatus {
  PAY_BEFORE
  PAY_AFTER
}

/// Where a reservation originated. Existing rows default to BOOKING_COM.
enum BookingSource {
  BOOKING_COM
  AGODA
}

/// Operational business type of a booking, independent of the OTA source.
/// DIRECT  = an ordinary retail reservation.
/// PARTNER = a B2B / agency / corporate / partner-rate reservation.
/// UNKNOWN = the detector had no confident evidence; the Admin should confirm.
enum BookingBusinessType {
  DIRECT
  PARTNER
  UNKNOWN
}

/// Proof-of-creation lifecycle for a dispatched booking. A receptionist creates
/// the reservation in the external hotel system, uploads a screenshot, and the
/// Admin approves or rejects it.
enum VerificationStatus {
  NOT_SUBMITTED
  PENDING_REVIEW
  APPROVED
  REJECTED
}

/// A single screenshot proof attempt.
enum ProofStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

/// Lifecycle of one OCR analysis run over a proof screenshot. Advisory only —
/// the analysis never approves/rejects a proof and never compares against the
/// booking. DISABLED means the OCR feature flag was off when the run was created;
/// FAILED means the provider errored (the proof itself stays valid regardless).
enum ProofAnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DISABLED
}

/// Why an Admin rejected a proof attempt (a stable code; UI shows Vietnamese).
enum ProofReviewReason {
  WRONG_CUSTOMER_NAME
  WRONG_BOOKING_CODE
  WRONG_DATES
  WRONG_ROOM_COUNT
  WRONG_ROOM_TYPE
  WRONG_PRICE
  MISSING_ROOM
  UNCLEAR_IMAGE
  OTHER
}

/// Severity of an extraction warning surfaced to the admin during preview.
enum WarningSeverity {
  INFO
  WARNING
  ERROR
}

/// Category of a receptionist-reported hotel issue.
enum IssueCategory {
  DOOR
  AIR_CONDITIONER
  TOILET
  TV
  WIFI
  ELECTRICITY
  WATER
  FURNITURE
  HOUSEKEEPING
  GUEST_REQUEST
  OTHER
}

/// Lifecycle of a reported hotel issue. Deliberately minimal: no workflow beyond
/// NEW → IN_PROGRESS → RESOLVED.
enum IssueStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

/// Application user: one administrator plus receptionists bound to a branch.
model User {
  id                 Int      @id @default(autoincrement())
  username           String   @unique
  passwordHash       String
  fullName           String
  role               UserRole
  /// Required for RECEPTIONIST, always null for ADMIN (admin sees all branches).
  branchId           Int?
  active             Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  /// Set on every successful login; null until the account logs in for the first time.
  lastLoginAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  branch            Branch?                @relation(fields: [branchId], references: [id])
  bookingsSent      Booking[]              @relation("BookingSentBy")
  bookingsCompleted Booking[]              @relation("BookingCompletedBy")
  bookingsReviewed  Booking[]              @relation("BookingReviewedBy")
  bookingsCreated   Booking[]              @relation("BookingCreatedBy")
  proofsSubmitted   BookingCreationProof[] @relation("ProofSubmittedBy")
  proofsReviewed    BookingCreationProof[] @relation("ProofReviewedBy")
  statusChanges     BookingStatusHistory[]
  notifications     Notification[]
  sessions          Session[]
  issuesReported    HotelIssue[]           @relation("IssueReportedBy")
  issuesAccepted    HotelIssue[]           @relation("IssueAcceptedBy")
  issuesResolved    HotelIssue[]           @relation("IssueResolvedBy")

  @@index([branchId])
  @@index([role])
}

/// Server-side login session backing express-session.
///
/// A native SQLite session store (connect-sqlite3 / better-sqlite3) is blocked
/// by this project's install-script allow-list, so sessions live in the same
/// Prisma/SQLite database — the simplest reliable persistent store here.
/// The browser only ever holds the opaque `id` (the session cookie); all
/// session data stays server-side in `data`. `userId` is denormalised out of
/// `data` so a user's sessions can be invalidated on disable / password reset.
model Session {
  id        String   @id
  /// express-session serialised session payload (JSON).
  data      String
  /// Owner of the session once authenticated; null for anonymous sessions.
  userId    Int?
  /// Absolute expiry; rows past this are pruned and treated as absent.
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// One of the 8 hotel branches bookings are dispatched to.
model Branch {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  /// Name as it appears in Booking.com text, used for fuzzy matching.
  hotelName String
  address   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  bookings Booking[]
  issues   HotelIssue[]
}

/// A Booking.com reservation extracted by the admin and dispatched to a branch.
model Booking {
  id String @id @default(cuid())

  /// Booking.com confirmation code. Not unique: a duplicate raises a warning
  /// for the admin rather than a hard database rejection.
  bookingCode String
  hotelName   String?
  branchId    Int?

  customerName String
  phone        String?

  /// Which platform the reservation came from. Defaults to BOOKING_COM so every
  /// pre-existing row is safe without a data backfill surprise.
  sourcePlatform BookingSource @default(BOOKING_COM)

  /// Operational business type, detected deterministically at extraction and
  /// optionally confirmed/overridden by an Admin. Defaults to UNKNOWN so existing
  /// rows migrate safely. Independent of sourcePlatform / branch / payment / proof.
  businessType                  BookingBusinessType @default(UNKNOWN)
  /// 0–100 confidence of the automatic detection (null when never detected).
  businessTypeConfidence        Int?
  /// A short machine tag for how the type was decided (e.g. "auto:partner-rate",
  /// "manual"), for audit — never shown to receptionists.
  businessTypeDetectionSource   String?
  /// True once an Admin has explicitly confirmed/overridden the type. When true
  /// the detector never runs again for this booking.
  businessTypeManuallyConfirmed Boolean             @default(false)

  /// Date-only values stored at UTC midnight. Times are free-form strings
  /// ("14:00", "sau 15:00") because Booking.com text is not consistent.
  /// Nullable so a partial extraction can still be stored as a DRAFT while a
  /// "missing dates" warning flags it for the admin to complete.
  checkInDate   DateTime?
  checkInTime   String?
  checkOutDate  DateTime?
  checkOutTime  String?

  /// Whole VND. Null when the total could not be extracted.
  totalAmount   Int?
  currency      String        @default("VND")
  paymentStatus PaymentStatus

  specialRequest String?
  /// Original pasted Booking.com text, kept permanently for auditing.
  rawText        String

  status       BookingStatus @default(DRAFT)
  /// True when check-in is today in Asia/Ho_Chi_Minh at dispatch time.
  isLastMinute Boolean       @default(false)

  /// Dispatch timestamp. History is grouped by this and it is never
  /// overwritten by completedAt.
  sentAt            DateTime?
  sentByUserId      Int?
  /// The receptionist's claim that they created the reservation externally
  /// (set when the first proof is submitted). Never overwritten by review.
  completedAt       DateTime?
  completedByUserId Int?
  completionNote    String?

  /// Proof-of-creation review state. NOT_SUBMITTED until a receptionist submits.
  verificationStatus VerificationStatus @default(NOT_SUBMITTED)
  /// The Admin who approved/rejected the current proof, and when.
  reviewedByUserId   Int?
  reviewedAt         DateTime?

  /// Which extraction-engine version produced this draft.
  parserVersion  String?
  /// The admin who ran the extraction that created this booking.
  createdByUserId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch        Branch?                 @relation(fields: [branchId], references: [id])
  sentBy        User?                   @relation("BookingSentBy", fields: [sentByUserId], references: [id])
  completedBy   User?                   @relation("BookingCompletedBy", fields: [completedByUserId], references: [id])
  reviewedBy    User?                   @relation("BookingReviewedBy", fields: [reviewedByUserId], references: [id])
  createdBy     User?                   @relation("BookingCreatedBy", fields: [createdByUserId], references: [id])
  rooms         BookingRoom[]
  statusHistory BookingStatusHistory[]
  notifications Notification[]
  warnings      BookingExtractWarning[]
  proofs        BookingCreationProof[]

  @@index([bookingCode])
  @@index([branchId, status])
  @@index([status])
  @@index([branchId, verificationStatus])
  @@index([verificationStatus])
  @@index([sourcePlatform])
  @@index([businessType])
  @@index([sentAt])
  @@index([checkInDate])
  @@index([isLastMinute])
  @@index([customerName])
  @@index([phone])
}

/// One immutable screenshot proof attempt that a receptionist created the
/// reservation in the external hotel system. Attempts are never overwritten or
/// hard-deleted; a resubmission creates a new attempt with the next number.
model BookingCreationProof {
  id             String             @id @default(cuid())
  bookingId      String
  /// 1-based attempt sequence for this booking (unique per booking).
  attemptNumber  Int
  /// Server-generated file name on disk (never the client's original name).
  storedFileName String
  /// The client's original name, kept only for display/audit — never trusted.
  originalFileName String
  mimeType       String
  fileSize       Int
  submissionNote String?
  submittedByUserId Int?
  submittedAt    DateTime           @default(now())

  status         ProofStatus        @default(PENDING_REVIEW)
  reviewedByUserId Int?
  reviewedAt     DateTime?
  reviewReasonCode ProofReviewReason?
  reviewNote     String?

  createdAt      DateTime           @default(now())

  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  submittedBy User?   @relation("ProofSubmittedBy", fields: [submittedByUserId], references: [id])
  reviewedBy  User?   @relation("ProofReviewedBy", fields: [reviewedByUserId], references: [id])
  analyses    BookingProofAnalysis[]

  @@unique([bookingId, attemptNumber])
  @@index([bookingId])
  @@index([status])
}

/// One immutable OCR analysis run over a proof screenshot. A proof may have many
/// runs (re-analysis creates a new row; earlier rows are never overwritten). The
/// extracted text and the structured fields are stored as plain TEXT (the JSON is
/// serialised to a string), never as image BLOBs and never as a filesystem path.
/// This record is advisory extraction only: it carries no MATCH/MISMATCH verdict
/// and no approval recommendation.
model BookingProofAnalysis {
  id             String              @id @default(cuid())
  proofId        String
  status         ProofAnalysisStatus @default(PENDING)
  /// Which provider produced the run, e.g. "tesseract", "disabled", "mock".
  provider       String
  /// A version stamp for the extraction logic, so old runs remain interpretable.
  analysisVersion String
  /// Raw OCR text, length-capped by the service before it is stored (never bytes).
  extractedText  String?
  /// Structured fields serialised as a JSON string (validated before storage).
  extractedDataJson String?
  /// Sanitised, user-safe error message when status is FAILED (never a stack/path).
  errorMessage   String?
  startedAt      DateTime?
  completedAt    DateTime?

  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  proof BookingCreationProof @relation(fields: [proofId], references: [id], onDelete: Cascade)

  @@index([proofId])
  @@index([proofId, status])
  @@index([createdAt])
}

/// One room within a booking. Rooms are never merged; each keeps its own prices.
model BookingRoom {
  id        String   @id @default(cuid())
  bookingId String
  /// 1-based position as shown in the UI ("Phòng 1", "Phòng 2").
  roomIndex Int
  roomType  String?
  /// Whole VND, null when not stated in the source text.
  roomSubtotal Int?
  taxAmount    Int?
  feeAmount    Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  booking Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  nights  BookingNightPrice[]

  @@unique([bookingId, roomIndex])
  @@index([bookingId])
}

/// The price of one individual stay night of one individual room.
/// One row per expected night: check-in inclusive to check-out exclusive.
model BookingNightPrice {
  id            String   @id @default(cuid())
  bookingRoomId String
  /// Date-only at UTC midnight. Never the check-out date.
  stayDate      DateTime
  /// Whole VND. Null means "Chưa xác định" — never guessed, averaged or
  /// derived by dividing a total.
  amount        Int?
  currency      String   @default("VND")
  /// True when the admin typed or corrected this amount by hand.
  manuallyCorrected Boolean  @default(false)
  /// True when the amount is a system estimate rather than a value Booking.com
  /// stated. The extraction engine never estimates money, so it always writes
  /// false; reserved for a future explicit "estimate" action.
  isEstimated       Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  bookingRoom BookingRoom @relation(fields: [bookingRoomId], references: [id], onDelete: Cascade)

  @@unique([bookingRoomId, stayDate])
  @@index([bookingRoomId])
  @@index([stayDate])
}

/// A single validation finding produced while extracting a booking from raw
/// Booking.com text (e.g. unknown hotel, missing dates, missing nightly price).
model BookingExtractWarning {
  id        String          @id @default(cuid())
  bookingId String
  /// Stable machine code, e.g. "UNKNOWN_HOTEL", "MISSING_NIGHTLY_PRICE".
  code      String
  /// Human-readable Vietnamese message shown to the admin.
  message   String
  severity  WarningSeverity @default(WARNING)
  createdAt DateTime        @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([code])
}

/// Immutable audit trail of every booking status transition.
model BookingStatusHistory {
  id              String         @id @default(cuid())
  bookingId       String
  oldStatus       BookingStatus?
  newStatus       BookingStatus
  changedByUserId Int?
  changedAt       DateTime       @default(now())
  note            String?

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  changedBy User?   @relation(fields: [changedByUserId], references: [id])

  @@index([bookingId])
  @@index([changedAt])
}

/// In-app notification delivered to a user (new booking / completion).
model Notification {
  id        String   @id @default(cuid())
  userId    Int
  bookingId String?
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  readAt    DateTime?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

/// A hotel issue a receptionist reports to the Admin after receiving a booking
/// (broken door, AC not cold, clogged toilet, guest request, …). Reports are kept
/// permanently — never hard-deleted — and are scoped to the reporter's branch.
model HotelIssue {
  id          String        @id @default(cuid())
  branchId    Int
  /// Optional room number the issue relates to (free-form).
  roomNumber  String?
  category    IssueCategory
  description String
  /// Server-generated file name of the (optional, single) attached photo. Only
  /// metadata + a safe relative path live here, never the image bytes.
  photoStoredName String?
  photoMimeType   String?

  status IssueStatus @default(NEW)

  reportedByUserId Int
  /// The Admin who moved the issue to IN_PROGRESS / RESOLVED (audit).
  acceptedByUserId Int?
  resolvedByUserId Int?
  resolvedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch     Branch @relation(fields: [branchId], references: [id])
  reportedBy User   @relation("IssueReportedBy", fields: [reportedByUserId], references: [id])
  acceptedBy User?  @relation("IssueAcceptedBy", fields: [acceptedByUserId], references: [id])
  resolvedBy User?  @relation("IssueResolvedBy", fields: [resolvedByUserId], references: [id])

  @@index([branchId, status])
  @@index([status])
  @@index([createdAt])
  @@index([reportedByUserId])
}
